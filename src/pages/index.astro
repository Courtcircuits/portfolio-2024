---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {Window} from '../components/Window.tsx';
import { SITE_TITLE, SITE_DESCRIPTION, SOCIALS, RESUME_LINK, PROJECTS, HACKATHONS, TALKS, CONTRIBUTIONS } from '../consts';
import LinkTable from '../components/LinkTable.astro';
import { getCollection } from 'astro:content';
import { Preview } from '../components/Preview.tsx'
const collection = await getCollection('blog');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link rel="prefetch" as ="image" href="/gists.png"/>
    <link rel="prefetch" as ="image" href="/do-compressed3.png"/>

<style>astro-island,astro-slot,astro-static-slot{display:contents; z-index:1000}</style> <!-- here -->
	</head>
	<body>
		<main>
      <h1>Hi there, I'm <em>Tristan Radulescu</em></h1>
      <p>
      I'm a developer based in montpellier, france. Right now, I'm building 
      <Preview client:only="react" trigger="htc">
        <Preview.Trigger client:only="react" trigger="htc">
		<a href="https://hackthecrous.com">Hack The Crous</a>
        </Preview.Trigger>
        <Preview.Content client:only="react" trigger="htc">
          <Window title='HACK THE CROUS' className='rotate-3'>
            <img src="/hackthecrous.png" width={200} class="p-1" />
            </Window>
        </Preview.Content>
      </Preview>, a nice tool to help student eat healthy.
      </p>
      <p>
      I am also a student at <Preview client:only="react" trigger="polytech">
        <Preview.Trigger client:only="react" trigger="polytech">
          <em>polytech montpellier</em>
        </Preview.Trigger>
        <Preview.Content client:only="react" trigger="polytech">
          <Window title='DO 2k23-26' className='rotate-3'>
            <img src="/do-compressed3.png" width={200} class="p-1 z-100 relative" />
            </Window>
        </Preview.Content>
      </Preview> (in the devops section) and I'm currently an apprentice in saving the world at <a href="https://sweep.net">sweep</a> mainly working on integrating agentic AI to the platform and fixing performance issues related to realtime analytics.
      </p>
      <p>
      When I'm not struggling with some random <a href="https://www.root-me.org/Milou666">cryptanalysis</a> <a href="https://cryptohack.org/user/Milou666/">challenge</a>, I play music with my alt/grunge/post-rock band 
      <Preview client:only="react" trigger="blackapril">
        <Preview.Trigger client:only="react" trigger="blackapril">
      <a href="https://www.instagram.com/black.april_band/" >black april✨</a>
        </Preview.Trigger>
        <Preview.Content client:only="react" trigger="blackapril">
          <Window title='BLACK_APRIL.GIF' className='rotate-6'>
            <img src="/blackapril.gif" width={200} class="p-1" />
            </Window>
        </Preview.Content>
      </Preview>.
      </p>
      <!-- <p class="bg-accentlight text-primary w-fit">My favorite topics when it comes to computers are cryptology, virtualization and distributed systems</p> -->
      <p class="w-3/4">
      Here are my socials : {
      SOCIALS.map((item, index) => (
      <span>
      <a href={item.link}>{item.name}</a>
      { index != SOCIALS.length -1 ? "·" : ""}
      </span>
      ))
      }</br>
      in case you're old school, 
      <Preview client:only="react" trigger="cv">
        <Preview.Trigger client:only="react" trigger="cv">
<a   href={RESUME_LINK}>download my resume here</a>
        </Preview.Trigger>
        <Preview.Content client:only="react" trigger="cv">
          <Window title='RESUME.PDF' className='rotate-3'>
            <img src="/cv.png" class="p-1" />
            </Window>
        </Preview.Content>
      </Preview>.
      </p>

      <LinkTable title="MY WORK" items={PROJECTS}/>
      <LinkTable title="MY OS CONTRIBUTIONS" items={CONTRIBUTIONS}/>
      <LinkTable title="MY WRITINGS" items={collection.map(({data, slug})=>(
                 {
                    name: data.title,
                 to: `/articles/${slug}`,
                description: `${data.pubDate.toLocaleDateString()}`
                 }))}/>
      <LinkTable title="MY TALKS" items={TALKS}/>
      <Footer/>
		</main>


	</body>
<script>
  document.querySelectorAll(".up").forEach((el)=>{
    el.classList.add("z-100")
  })
</script>
</html> 
