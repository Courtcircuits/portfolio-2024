---
import {Preview} from './Preview.tsx';
interface Props {
  title: string;
  items: 
    {
      name: string;
      to: string;
      at?: string;
      description?: string;
      preview?: string;
    }[]
  
}

const {title, items} = Astro.props;

function transformToId(value) {
		return value.replaceAll(" ", "-").toLowerCase();
}

const id = transformToId(title);
---

<section class="w-full mt-[70px]">
		<h2 id={id}>{title}</h2>
  <ol>
  {
  items.length == 0 ? <p>No items</p> :
  items.map(({to, name, description, at}, index) => (
      <button class="relative flex flex-row w-full items-end py-2 group cursor-pointer" onclick=`location.href = '${to}';`>

          <div class="absolute bg-accentlight w-full h-full -z-10 custom-transition"></div>
          <p class="m-0 w-[40px] text-right group-hover:text-white">#{index+1}. </p>
          <hr class="flex-grow mb-[7px] mx-6 mx-1 group-hover:border-t-white"/>
          <span class="flex flex-col items-end m-0 p-0 ">
          <a href={to} class="no-underline group-hover:text-white text-right">{name}</a>
          {
            at ? <p class="text-right group-hover:text-white text-sm m-0 p-0">@{at}</p> : null
          }
          {
            description ? <p class="text-right group-hover:text-white text-sm m-0 p-0">{description}</p> : null
          }
          </span>
      </button>
  ))
  }
  </ol>
</section>
